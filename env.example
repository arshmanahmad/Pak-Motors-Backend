# Pak Motors Backend - Environment Variables Example
# Copy this file to .env and update with your actual values

# Server Configuration
HOST=localhost
PORT=3000

# CORS Configuration
# For multiple origins, separate with semicolon (;)
CORS_ORIGIN=http://localhost:3001;http://localhost:3000

# Rate Limiting
COMMON_RATE_LIMIT_MAX_REQUESTS=1000
COMMON_RATE_LIMIT_WINDOW_MS=1000

# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017/pak-motors-db
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/database-name

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Password Hashing
BCRYPT_SALT_ROUNDS=10

# Email Configuration (for OTP and notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# OTP Configuration (optional, defaults to 5 if not set)
OTP_MAX_ATTEMPTS=5

